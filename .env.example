# Copie para .env e ajuste. O .env NUNCA vai para o Git.

APP_NAME="Plataforma EAD"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.com.br
APP_TIMEZONE=America/Sao_Paulo
# Gere com: php bin/ead key  (assina os certificados; não troque depois de emitir)
APP_KEY=

# true = versão pública de demonstração (bloqueia exclusões e mostra os acessos de teste)
DEMO_MODE=false

DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# log = grava os e-mails em storage/logs/mail.log | smtp = envia de verdade
MAIL_DRIVER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=nao-responda@seu-dominio.com.br
MAIL_FROM_NAME="Plataforma EAD"

SESSION_LIFETIME=120
UPLOAD_MAX_MATERIAL_MB=25
UPLOAD_MAX_VIDEO_MB=512

# Instalação pelo navegador (sem SSH): defina um token longo, acesse /instalar?token=... e depois APAGUE esta linha.
INSTALL_TOKEN=
